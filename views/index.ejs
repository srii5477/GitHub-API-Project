<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GitHubAPI Demo</title>
    <link rel="stylesheet" href= "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" /> 
    <link href="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/7.1.0/mdb.min.css" rel="stylesheet"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300&display=swap" rel="stylesheet">
    <link href="style.css" rel="stylesheet" />

</head>
<body>
    <div class="header">
        <div class="txt"> <h1> Your Guide to GitHub </h1> </div>
        <div class="icon"> <a href="#" class="fa fa-github"></a> </div>
    </div>
    <div class="body">
        <!-- search for a user -->
        <h2> Read from a user's profile: </h2>
        <form action="/" method="POST">
        <div class="input-group" style="margin-bottom: 5%;">
                
                <input type="text" name="search" class="form-control rounded" placeholder="Search" aria-label="Search" aria-describedby="search-addon" />
                <button type="submit" class="btn btn-outline-light" data-mdb-ripple-init>search</button>  
        </div>
        </form>
        <div class="flex">
        <% if(locals.user) { %>
            <h2> Public repos: 
                <% if(locals.repos) { %>
                    <ul>
                        <% for(let i=0; i<repos.length; i++) { %>
                            <li style="font-size: 20px;"> <%= repos[i].name %> </li>
                        <% } %>
                    </ul>
                <% } %>
            </h2>
            <h2> Followers: <%= user.followers %> </h2>
            <h2> Following: <%= user.following %> </h2>
            <h2> Starred repos:   
                <% if(locals.starred) { %>
                <ul>
                    <% for(let i=0; i<starred.length; i++) { %>
                        <li style="font-size: 20px;"> <%= starred[i].name %> </li>
                    <% } %>
                </ul>
                <% } %>
            </h2>
           
        <% } %>
        </div>
        <h2 style="color: rgb(225, 151, 246); font-weight: bolder; width: 130%; "> Perform CRUD Operations in your repositories and upon their contents.</h2>
        <div class="input">

            <form method="POST">
            <input type="password" name="token" placeholder="Enter your Personal Access Token" style="width: 50%; height: 40px;"/>
            <input type="text" name="username" placeholder="Enter your username if you want to create/update a repo" style="width: 100%; height: 40px; margin-top: 5%;"/>
            <input type="text" name="repo" placeholder="Search for a repo to update/delete/read or enter a new repo name. " style="width: 100%; margin-top: 5%; height: 40px;"/>
            <input type="text" name="desc" placeholder="Enter a description for the repo if you are creating/update it." style="width: 100%; margin-top: 5%; height: 40px;"/>
            <!-- <input type="text" name="file" placeholder="Enter the name of the file within your repo you want to create/update." style="width: 70%; margin-top: 5%; height: 40px;"/> 
            <textarea name="content" placeholder="Enter the content of the file if you are creating/updating it." rows="20" cols="45" style="margin-top: 5%;"></textarea> -->
            <input type="text" name="visibility" placeholder="Do you want your repo to be public or private?" style="width: 100%; margin-top: 5%; height: 40px;"/>
            <input type="text" name="path" placeholder="Enter the path of the file you wish to read within your repo." style="width: 100%; margin-top: 5%; height: 40px;"/>
            <div class="crud" style="margin-top: 5%;">
                <button type="submit" formaction="/create" class="btn btn-outline-light" data-mdb-ripple-init>Create</button>
                <button type="submit" formaction="/update" class="btn btn-outline-light" data-mdb-ripple-init>Update</button>
                <button type="submit" formaction="/read" class="btn btn-outline-light" data-mdb-ripple-init>Read</button>
            </div>
            </form>
        </div> 

        <div class="info">
            <% if(locals.new_repo) { %>
                <h2><%= new_repo.name %> succesfully created! </h2>
            <% } %>
            <% if(locals.updated_repo) { %>
                <h2><%= updated_repo.name %> succesfully updated! </h2>
            <% } %>
            <% if(locals.read_repo) { %>
                <h2><%= read_repo.name %> succesfully read! </h2>
                <h2> <b> <u> Contents: </u> </b> </h2>
                <h4 style="font-size: 20px; color: rgb(241, 216, 255); margin-top: 3%;"> <%= content %> </h4>
            <% } %>
        </div>

        <div class="curious">
            <h2 style="color: rgb(225, 151, 246); font-weight: bolder; width: 130%;">Explore the ocean of code repositories in GitHub, satiate your curiosity.</h2>
            <form method="POST" action="/search">
                <input type="password" name="token" placeholder="Enter your Personal Access Token" style="width: 50%; height: 40px;"/>
                <input type="text" name="keyword" placeholder="Enter what you are looking for." />
                <button type="submit" class="btn btn-outline-light" data-mdb-ripple-init>Go</button>
            </form>
            <div class="res" style="color: white; margin-top: 5%;">
                <% for(let i = 0; i < info.length; i++) { %>
                    <h3 style="font-size: 24px;"> <%= i %>. <b><%=info[i].full_name%></b> </h3> 
                    <h4><a style="color: rgb(237, 147, 237);" href="<%=info[i].html_url%>"> Link </a></h4>
                    <h5><%=info[i].description.substring(0, 100)%></h5>
                <% } %>
            </div>
        </div>
    </div>
    
</body>
</html>